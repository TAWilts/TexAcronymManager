{
  "name": "tacroman-vscode",
  "displayName": "TAcroMan",
  "description": "Smart LaTeX acronym completion, plain-text detection, interactive replacement, and TAcroMan database integration.",
  "version": "0.5.2",
  "publisher": "tawilts",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "latex",
    "tex",
    "acronym",
    "acronyms",
    "abbreviation",
    "abbreviations",
    "glossary",
    "academic-writing",
    "scientific-writing",
    "thesis",
    "dissertation",
    "paper",
    "overleaf",
    "latex-workshop",
    "autocomplete",
    "completion",
    "intellisense",
    "linter",
    "quick-fix",
    "search-replace",
    "ac",
    "acp",
    "tacroman"
  ],
  "activationEvents": [
    "onLanguage:latex",
    "onCommand:tacroman.selectDatabase",
    "onCommand:tacroman.open",
    "onCommand:tacroman.reload",
    "onView:tacroman.acronymExplorer",
    "onCommand:tacroman.sidebar.search",
    "onCommand:tacroman.sidebar.clearFilter",
    "onCommand:tacroman.insertAcronym",
    "onCommand:tacroman.insertAcronymPlural",
    "onCommand:tacroman.checkAcronyms"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tacroman.selectDatabase",
        "title": "TAcroMan: Select Database",
        "icon": "$(folder-opened)"
      },
      {
        "command": "tacroman.open",
        "title": "TAcroMan: Open TAcroMan",
        "icon": "$(link-external)"
      },
      {
        "command": "tacroman.reload",
        "title": "TAcroMan: Reload Database",
        "icon": "$(refresh)"
      },
      {
        "command": "tacroman.sidebar.search",
        "title": "TAcroMan: Filter Acronyms",
        "icon": "$(search)"
      },
      {
        "command": "tacroman.sidebar.clearFilter",
        "title": "TAcroMan: Clear Acronym Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "tacroman.insertAcronym",
        "title": "TAcroMan: Insert \\ac{...}",
        "icon": "$(symbol-key)"
      },
      {
        "command": "tacroman.insertAcronymPlural",
        "title": "TAcroMan: Insert \\acp{...}"
      },
      {
        "command": "tacroman.checkAcronyms",
        "title": "TAcroMan: Check Current File for Acronyms",
        "icon": "$(checklist)"
      }
    ],
    "configuration": {
      "title": "TAcroMan",
      "properties": {
        "tacroman.databasePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the TAcroMan JSON database. Relative paths are resolved from the workspace folder. Leave empty for automatic discovery of acronyms.json files."
        },
        "tacroman.latexCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ac",
            "acp",
            "acs",
            "acsp",
            "acl",
            "aclp",
            "acf",
            "acfp",
            "Ac",
            "Acp"
          ],
          "description": "LaTeX commands for which TAcroMan should offer completion inside the first braced argument. Enter command names without the leading backslash."
        },
        "tacroman.executablePath": {
          "type": "string",
          "default": "",
          "description": "Optional explicit executable used by 'TAcroMan: Open TAcroMan'. Leave empty to use the launcher published by the TAcroMan desktop application, with 'tacroman' from PATH as a final fallback."
        },
        "tacroman.launchArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed when TAcroMan is launched from VS Code."
        },
        "tacroman.maxCompletionItems": {
          "type": "integer",
          "default": 250,
          "minimum": 10,
          "maximum": 5000,
          "description": "Maximum number of acronym completion items returned at once."
        },
        "tacroman.plainTextCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Offer acronym completions while typing known short or long forms directly in LaTeX prose."
        },
        "tacroman.plainTextDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Detect known acronyms written as plain text in LaTeX documents and offer Quick Fixes."
        },
        "tacroman.quickFixSingularCommand": {
          "type": "string",
          "default": "ac",
          "description": "LaTeX command used by the Quick Fix for singular plain-text acronyms (without the leading backslash)."
        },
        "tacroman.quickFixPluralCommand": {
          "type": "string",
          "default": "acp",
          "description": "LaTeX command used by the Quick Fix for plural plain-text acronyms (without the leading backslash)."
        },
        "tacroman.inferPlainTextPlurals": {
          "type": "boolean",
          "default": true,
          "description": "Also recognize a simple short-form plural by appending s when the TAcroMan database has no explicit short_plural value."
        },
        "tacroman.ignoredArgumentCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ac",
            "acp",
            "acs",
            "acsp",
            "acl",
            "aclp",
            "acf",
            "acfp",
            "Ac",
            "Acp",
            "cite",
            "citep",
            "citet",
            "ref",
            "eqref",
            "pageref",
            "label",
            "url",
            "path",
            "input",
            "include",
            "bibliography",
            "bibliographystyle"
          ],
          "description": "LaTeX commands whose first braced argument should be ignored by plain-text acronym detection. Enter names without the leading backslash."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "tacroman-sidebar",
          "title": "TAcroMan",
          "icon": "$(symbol-key)"
        }
      ]
    },
    "views": {
      "tacroman-sidebar": [
        {
          "id": "tacroman.acronymExplorer",
          "name": "Acronyms"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tacroman.sidebar.search",
          "when": "view == tacroman.acronymExplorer",
          "group": "navigation@1"
        },
        {
          "command": "tacroman.sidebar.clearFilter",
          "when": "view == tacroman.acronymExplorer && tacroman.sidebar.filterActive",
          "group": "navigation@2"
        },
        {
          "command": "tacroman.reload",
          "when": "view == tacroman.acronymExplorer",
          "group": "navigation@3"
        },
        {
          "command": "tacroman.selectDatabase",
          "when": "view == tacroman.acronymExplorer",
          "group": "tacroman@1"
        },
        {
          "command": "tacroman.open",
          "when": "view == tacroman.acronymExplorer",
          "group": "navigation@4"
        },
        {
          "command": "tacroman.checkAcronyms",
          "when": "view == tacroman.acronymExplorer",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "tacroman.insertAcronym",
          "when": "view == tacroman.acronymExplorer && viewItem == tacroman.acronym",
          "group": "navigation@1"
        },
        {
          "command": "tacroman.insertAcronymPlural",
          "when": "view == tacroman.acronymExplorer && viewItem == tacroman.acronym",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "version:prepare": "node ./scripts/prepare-version.js",
    "package": "npm run version:prepare && vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TAWilts/TexAcronymManager.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/TAWilts/TexAcronymManager/issues"
  },
  "homepage": "https://github.com/TAWilts/TexAcronymManager",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "icon": "assets/icon.png"
}
