    "preamble_hint": "In the preamble: \\usepackage[acronym]{glossaries-extra}",
    "header": "",
    "entry": "\\newacronym{[[id]]}{[[short]]}{[[long]]}",
    "footer": "\n",
    "separator": "\n",
    "sort_by": "short",
    "escape_mode": "none",
    "usage_template": "\\gls{[[id]]}"
  },
