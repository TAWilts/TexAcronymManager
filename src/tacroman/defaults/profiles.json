[
  {
    "id": "acronym-package",
    "name": "acronym package (input file)",
    "description": "Produces an acronym environment with \\acro{SHORT}{long form}.",
    "preamble_hint": "In the preamble: \\usepackage[printonlyused]{acronym}",
    "header": "\\begin{acronym}\n",
    "entry": "\\acro{[[short]]}{[[long]]}",
    "footer": "\n\\end{acronym}\n",
    "separator": "\n",
    "sort_by": "short",
    "escape_mode": "none",
    "usage_template": "\\ac{[[short]]}"
  },
  {
    "id": "acronym-complete-snippet",
    "name": "acronym package (complete block)",
    "description": "Produces the complete snippet, including the package line and acronym environment.",
    "preamble_hint": "Already includes \\usepackage[printonlyused]{acronym}. Use for direct insertion, not as an \\input file in the document body.",
