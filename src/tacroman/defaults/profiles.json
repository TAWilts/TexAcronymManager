    "entry": "\\acro{[[short]]}{[[long]]}",
    "footer": "\n\\end{acronym}\n",
    "separator": "\n",
    "sort_by": "short",
    "escape_mode": "none",
    "usage_template": "\\ac{[[short]]}"
  },
  {
    "id": "acro-package",
    "name": "acro package",
    "description": "Produces individual \\DeclareAcronym definitions for the acro package.",
    "preamble_hint": "In the preamble: \\usepackage{acro}",
    "header": "",
    "entry": "\\DeclareAcronym{[[id]]}{\n  short = [[short]],\n  long = [[long]]\n}",
    "footer": "\n",
    "separator": "\n\n",
    "sort_by": "short",
    "escape_mode": "none",
    "usage_template": "\\ac{[[id]]}"
  },
  {
    "id": "glossaries-extra",
